#!/bin/sh
#
# PROVIDE: ceph_mon
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# Ceph cluster monitor daemon.
#
# /etc/rc.conf:
#   ceph_mon_enable="YES"
#
# Optional (shared knobs: ${CEPH_PREFIX}/libexec/ceph/rc.ceph.subr):
#
# ceph_mon_instances (str):	Instance ids.  Default: discovered from
#				${ceph_datadir}/mon/${ceph_cluster}-<id>
# ceph_mon_flags (str):		Extra arguments for ceph-mon.
# ceph_mon_limits (str):		limits(1) arguments.  Default: "-n 1048576".
#
# service ceph_mon start		all instances
# service ceph_mon start a	mon.a only
#

. /etc/rc.subr

name="ceph_mon"
rcvar="ceph_mon_enable"
desc="Ceph cluster monitor daemon"

load_rc_config "${name}"
: ${CEPH_PREFIX:=/usr/local}
: ${CEPH_PREFIX:=/usr/local}

: ${ceph_mon_enable:="NO"}

ceph_type="mon"
ceph_bin="${CEPH_PREFIX}/bin/ceph-mon"

. ${CEPH_PREFIX}/libexec/ceph/rc.ceph.subr

ceph_dispatch "$@"
